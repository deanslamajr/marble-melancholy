{
  "name": "marble-melancholy",
  "version": "1.0.0",
  "description": "Marble Melancholy — an isometric marble racer for the browser with a built-in level builder.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mmlevel": "tools/levelc/bin.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run levels:check",
    "preview": "vite preview --port 4173 --strictPort",
    "deploy": "npm run build && tsx tools/deploy/gke.ts deploy",
    "deploy:status": "tsx tools/deploy/gke.ts status",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run levels:check && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=pixel --project=pixel-landscape --project=iphone --project=iphone-landscape --project=iphone15-landscape --project=galaxy-landscape",
    "test:perf": "playwright test --project=perf --no-deps",
    "levels:build": "tsx tools/levelc/cli.ts build-all",
    "levels:check": "tsx tools/levelc/cli.ts check levels/compiled",
    "levels:schema": "tsx tools/levelc/cli.ts schema --out levels/schema",
    "icons": "tsx tools/icons/generate.ts",
    "api:build": "vite build --config vite.server.config.ts",
    "api:start": "node dist-server/server.mjs",
    "mmlevel": "tsx tools/levelc/cli.ts"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "pg": "^8.23.1",
    "preact": "^10.22.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "commander": "^12.1.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "zod-to-json-schema": "^3.23.2"
  }
}
