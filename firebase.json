{
  "hosting": {
    "site": "marble-melancholy",
    "public": "dist",
    "ignore": ["**/.*"],
    "headers": [
      {
        "regex": "^/(index\\.html)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
      }
    ]
  }
}
